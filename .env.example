# ==============================================================================
# Homelab OS Command Center Configuration Template (.env.example)
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your real .env to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Freelancer.com OAuth & Credentials
# ------------------------------------------------------------------------------
# Get your token at https://www.freelancer.com/developers/tokens
FREELANCER_OAUTH_TOKEN=your_freelancer_oauth_token_here
FREELANCER_USER_ID=your_freelancer_numeric_user_id

# ------------------------------------------------------------------------------
# 2. Discord Webhook Notifications
# ------------------------------------------------------------------------------
# Create a webhook under Discord Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ------------------------------------------------------------------------------
# 3. Security & Dashboard Authentication
# ------------------------------------------------------------------------------
# 4-digit PIN required to unlock dashboard and authorize bids/deletions
DASHBOARD_PIN=1337
API_AUTH_PIN=1337

# ------------------------------------------------------------------------------
# 4. Web App & Public Endpoints
# ------------------------------------------------------------------------------
# Your deployed Vercel URL
VERCEL_APP_URL=https://your-homelab-app.vercel.app

# Public Cloudflare tunnel URL for your Android phone node (auto-generated by cloudflared)
J5_TUNNEL_URL=https://your-tunnel.trycloudflare.com

# ------------------------------------------------------------------------------
# 5. Fiverr Zero-Ban IMAP Client Inquiry Poller
# ------------------------------------------------------------------------------
# Use a Gmail App Password (16 characters) if 2FA is enabled on your email
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
IMAP_SERVER=imap.gmail.com

# ------------------------------------------------------------------------------
# 6. ESP32-C3 Pi-hole / DNS Ad-Blocker LAN Node
# ------------------------------------------------------------------------------
# Local network IP and HTTP port of your ESP32 Pi-hole DNS blocker
ESP32_PIHOLE_IP=192.168.1.50
ESP32_PIHOLE_PORT=80
GATEWAY_IP=192.168.1.1
