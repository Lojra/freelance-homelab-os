{
  "version": 2,
  "cleanUrls": true,
  "env": {
    "FREELANCER_OAUTH_TOKEN": "YOUR_FREELANCER_OAUTH_TOKEN",
    "FREELANCER_USER_ID": "YOUR_FREELANCER_USER_ID",
    "API_AUTH_PIN": "1337",
    "J5_TUNNEL_URL": "https://your-tunnel.trycloudflare.com"
  },
  "routes": [
    {
      "src": "/api/homework/run",
      "dest": "/api/homework"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/homework_latest.pdf",
      "dest": "https://your-tunnel.trycloudflare.com"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
